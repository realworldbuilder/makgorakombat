{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The room relay for online play: one Durable Object per room code, forwarding each player's
  // messages to the other, and one lobby where players find each other by name. It keeps
  // nothing of the game; see README.md. With a Discord bot, a voice channel for each match (voice.ts). And the site's own visit counts, one Durable Object (site.ts), and what players say at the end of a fight, another (feedback.ts).
  "name": "makgora-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "SITE", "class_name": "Site" },
      { "name": "FEEDBACK", "class_name": "FeedbackStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["Site"] },
    { "tag": "v4", "new_sqlite_classes": ["FeedbackStore"] }
  ],
  // Once an hour, the voice channels on Discord that closed rooms left behind are deleted (voice.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
