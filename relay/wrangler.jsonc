{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The room relay for online play: one Durable Object per room code, forwarding each player's
  // messages to the other, and one lobby where players find each other by name. It keeps
  // nothing of the game; see README.md. And the site's own visit counts, one Durable Object (site.ts).
  "name": "makgora-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "SITE", "class_name": "Site" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["Site"] }
  ],
  "observability": { "enabled": true }
}
